  {
    item: '스튜디오 패키지',
    price: '1,100,000 ~ 1,300,000원',
    detail: '스드메 계약 시 200,000원 지원',
  },
  {
    item: '촬영데이터',
    price: '440,000 ~ 550,000원',
    detail: '원본, 수정본 파일',
  },
  {
    item: '혼주 헤어·메이크업',
    price: '여 200,000원 / 남 80,000원',
    detail: '오전 7시 이전 진행 시 얼리스타트 비용 발생',
  },
  {
    item: '혼주 한복',
    price: '400,000원',
