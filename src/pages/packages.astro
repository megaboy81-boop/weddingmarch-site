const categories = [
  {
    name: 'Studio',
    nameKo: '스튜디오 촬영',
    desc: '제휴 스튜디오 10곳 중 선택하며 담당자 지정·야외/야간·앨범 등 선택 가능.',
    price: '110 ~ 130만원',
    priceNote: '스드메 계약 시 20만원 지원',
    anchor: 'studio',
  },
  {
    name: 'Dress',
    nameKo: '드레스',
    desc: '본식·촬영 드레스 대여. 핼퍼·디자인 추가·재피팅·턱시도 옵션 선택 가능.',
    price: '본식 패키지 180만원',
    priceNote: '드레스 투어 5만원',
    anchor: 'dress',
  },
  {
    name: 'Hair & Make',
    nameKo: '헤어·메이크업',
    desc: '본식·앞잔치·테스트·일반(혼주) 헤어메이크업. 담당자 지정·헤어피스·얼리스타트 등 선택.',
    price: '본식 65만원부터',
