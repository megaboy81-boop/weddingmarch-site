    transition:
      opacity 0.5s ease,
      transform 0.58s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .season-event-modal.hidden .season-event-frame {
    opacity: 0;
    transform: translateY(18px) scale(0.96);
  }

  .season-event-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(26, 16, 8, 0.16);
    border-radius: 999px;
    background: rgba(251, 250, 247, 0.92);
    color: #1a1008;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(17, 11, 8, 0.14);
  }

  .season-event-banner {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100vh - 44px);
    object-fit: contain;
  }

  @media (max-width: 760px) {
    .season-event-modal {
      padding: 14px;
      align-items: start;
      overflow: auto;
    }

    .season-event-frame {
      width: min(100%, 520px);
      max-height: calc(100dvh - 28px);
    }

    .season-event-banner {
      max-height: calc(100dvh - 28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .season-event-modal,
    .season-event-backdrop,
    .season-event-frame {
      transition: none;
    }
  }
</style>

<script>
  const eventModal = document.getElementById('seasonEventModal');
  if (eventModal) {
    let autoCloseTimer: ReturnType<typeof window.setTimeout> | undefined;
    const closeEventModal = () => {
      if (autoCloseTimer) window.clearTimeout(autoCloseTimer);
      eventModal.classList.add('hidden');
      eventModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };
    const openEventModal = () => {
      eventModal.classList.remove('hidden');
      eventModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      autoCloseTimer = window.setTimeout(closeEventModal, 10000);
    };
    window.setTimeout(openEventModal, 450);
    eventModal.querySelectorAll('[data-event-close]').forEach((element) => {
      element.addEventListener('click', closeEventModal);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !eventModal.classList.contains('hidden')) closeEventModal();
    });
  }

  // 스튜디오 선택 품목 아코디언
  document.querySelectorAll('.acc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = btn.parentElement!.querySelector<HTMLElement>('.acc-body')!;
      const icon = btn.querySelector<SVGElement>('.acc-icon')!;
      const isOpen = !body.classList.contains('hidden');
      if (isOpen) {
        body.classList.add('hidden');
        icon.style.transform = '';
      } else {
        body.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });

  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const answer = item.querySelector<HTMLElement>('.faq-answer')!;
      const icon = btn.querySelector<SVGElement>('.faq-icon')!;
      const isOpen = !answer.classList.contains('hidden');

      // 모두 닫기
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(ic => (ic as HTMLElement).style.transform = '');

      if (!isOpen) {
        answer.classList.remove('hidden');
        icon.style.transform = 'rotate(45deg)';
      }
    });
  });
</script>
