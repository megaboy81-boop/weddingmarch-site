  { name: '이포토에세이', base: '100~120만',  staff: '220,000',                                  outdoor: '야간 220,000 (오후 필수)',             raw: '440,000' },
  { name: '브라키오',     base: '100~120만',  staff: '작가지정 200,000 · 2인추가 300,000 · 영상추가 300,000', outdoor: '야외 무료 · 야간 110,000 · 샴페인샤워 55,000', raw: '440,000' },
  { name: '플로우',       base: '110~130만',  staff: '실장 110,000 · 이사 330,000',             outdoor: '노을&야간 무료',                       raw: '440,000' },
  { name: '섬',          base: '110~130만',  staff: '작가 150,000',                             outdoor: '야간 220,000 (오후 필수)',             raw: '550,000' },
