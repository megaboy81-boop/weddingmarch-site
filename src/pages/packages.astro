  { name: '춘천 피아',     base: '110~130만',  staff: '대표 지정 30만',                          outdoor: '야외/야간 서비스',                    raw: '440,000' },
  { name: '원주 테라스',   base: '110~130만',  staff: 'ㅡ',                                       outdoor: '야간 10만',                            raw: '440,000' },
  { name: '원규',         base: '120~140만',  staff: '실장 200,000 · 팀장 100,000',             outdoor: '야간 로드씬 22만',                     raw: '440,000' },
