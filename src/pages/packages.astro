---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = '춘천 웨딩 스드메 가격 · 정찰 패키지 | 웨딩마치 춘천';
const description = '춘천 웨딩마치 본식 패키지 180만원, 스튜디오 패키지 110~130만원, 촬영데이터 44~55만원 안내. 제휴 스튜디오·드레스·헤어메이크업 기본가와 환불·위약금 기준 공개.';
const ogImage = '/images/bg-new/gal1.webp';

// ── 대표 정찰 금액 (가격표시제 대응용 상단 노출) ──
const fixedPriceRows = [
